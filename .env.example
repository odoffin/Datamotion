# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Both values are public by design: NEXT_PUBLIC_* variables are sent to the
# browser. Do not put a secret or service-role key here.
#
# The app does not call Supabase yet (lessons run entirely in the browser),
# so it builds and runs with these left empty.

# Supabase project URL: Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (starts with sb_publishable_): Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
